
{
  "title": "Canon PR5500-C",
  "rules": [
    {
      "description": "PR5500-C: Play/Pause to Spokenly toggle",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "mute"
          },
          "to": [
            {
              "shell_command": "open -g 'spokenly://toggle'"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 11343,
                  "product_id": 12309,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
	{
	  "type": "basic",
	  "from": {
	    "key_code": "volume_decrement"
	  },
	  "to": [
            {
              "key_code": "v",
              "modifiers": ["left_command"],
              "hold_down_milliseconds": 100
            },
            {
              "key_code": "vk_none"
            }
          ],
	  "conditions": [
	    {
	      "type": "device_if",
	      "identifiers": [
		{
		  "vendor_id": 11343,
		  "product_id": 12309,
		  "is_keyboard": true
		}
	      ]
	    }
	  ]
	},
        {
          "type": "basic",
          "from": {
            "key_code": "volume_increment"
          },
          "to": [
            {
              "key_code": "return_or_enter",
              "hold_down_milliseconds": 100
            },
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 11343,
                  "product_id": 12309,
                  "is_keyboard": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

